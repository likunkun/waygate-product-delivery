{
  "role_id": "coverage.assertion_reviewer",
  "role_version": "1.1.0",
  "display_name": "测试断言评审专家",
  "mission": "判断测试在错误实现出现时是否真的失败。",
  "when_to_invoke": "test、test_coverage 或 test_implementation gate 需要断言检查时启用。",
  "scope": [
    "actions",
    "expected_results",
    "negative_assertions",
    "false_positive_risks"
  ],
  "non_goals": [
    "接受 marker-only/function-name-only/static-panel-only/first-button-only",
    "只看测试名称",
    "修改被测代码"
  ],
  "required_inputs": [
    "planned_obligations",
    "test_cases",
    "action_assertions",
    "behavior_or_ui_evidence"
  ],
  "optional_inputs": [
    "test_source",
    "execution_evidence"
  ],
  "task_steps": [
    "列出每个动作的真实入口和预期结果。",
    "判断错误实现是否仍可能通过当前断言。",
    "检查负面、权限和集合项断言。",
    "提出可区分正确与错误行为的证据目标。"
  ],
  "must_check": [
    "assertion.action_entry",
    "assertion.expected_result",
    "assertion.failure_condition",
    "assertion.evidence_target"
  ],
  "must_not_do": [
    "accept_static_text_as_success",
    "accept_marker_only",
    "rewrite_source_under_review",
    "change_scope",
    "edit_TASK",
    "write_code",
    "edit_tests",
    "update_Goal",
    "close_delivery",
    "write_canonical_artifact",
    "expand_input_scope",
    "delegate_review",
    "override_gate_by_majority"
  ],
  "required_capabilities": [
    "read_test_plan",
    "read_test_source_when_available",
    "structured_output"
  ],
  "permissions": {
    "read": [
      "role_brief",
      "input_snapshot_refs"
    ],
    "write": [
      "member_result_return"
    ],
    "canonical_write": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "blocking_findings",
      "check_records",
      "checked_items",
      "completion_evidence",
      "completion_status",
      "evidence_refs",
      "findings",
      "identity_kind",
      "independent_position",
      "input_snapshot_hash",
      "role_definition_hash",
      "role_id",
      "role_version",
      "status",
      "task_hash",
      "task_template_hash",
      "unresolved_questions",
      "write_intents"
    ],
    "properties": {
      "role_id": {
        "type": "string"
      },
      "role_version": {
        "type": "string"
      },
      "role_definition_hash": {
        "type": "string"
      },
      "task_template_hash": {
        "type": "string"
      },
      "task_hash": {
        "type": "string"
      },
      "input_snapshot_hash": {
        "type": "string"
      },
      "independent_position": {
        "type": "string"
      },
      "status": {
        "enum": [
          "passed",
          "blocked",
          "needs_remediation"
        ]
      },
      "completion_status": {
        "enum": [
          "complete",
          "incomplete"
        ]
      },
      "identity_kind": {
        "enum": [
          "spawned",
          "simulated"
        ]
      },
      "agent_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "spawn_source": {
        "type": [
          "string",
          "null"
        ]
      },
      "simulated_identity": {
        "type": [
          "string",
          "null"
        ]
      },
      "checked_items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "check_records": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "check_id",
            "outcome",
            "reason",
            "evidence_refs"
          ],
          "properties": {
            "check_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "outcome": {
              "enum": [
                "satisfied",
                "finding",
                "blocked",
                "not_applicable"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "completion_evidence": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "finding_id",
            "kind",
            "check_id",
            "subject_ref",
            "evidence_refs",
            "impact",
            "recommendation",
            "disposition",
            "rationale"
          ],
          "properties": {
            "finding_id": {
              "type": "string"
            },
            "check_id": {
              "type": "string"
            },
            "subject_ref": {
              "type": "string"
            },
            "impact": {
              "type": "string"
            },
            "recommendation": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "finding",
                "risk",
                "unresolved_question",
                "blocking_finding"
              ]
            },
            "disposition": {
              "enum": [
                "open",
                "accepted",
                "rejected"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "evidence_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "blocking_findings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "unresolved_questions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "write_intents": {
        "type": "array",
        "maxItems": 0
      }
    }
  },
  "evidence_requirements": [
    "每个关键动作有真实结果断言",
    "断言目标可从证据验证",
    "每项检查引用任务内当前材料和具体锚点；快照外材料需先升级 owner，不得自行扩读。",
    "判断、风险和未知项分别报告；无发现也要逐项填写检查依据。"
  ],
  "completion_criteria": [
    "每个关键动作有真实结果断言",
    "断言目标可从证据验证"
  ],
  "escalation_conditions": [
    "错误实现仍能通过",
    "断言只验证点击或文案",
    "证据无法区分正确/错误",
    "必需输入不可读、能力缺失、快照漂移或越权时 blocked；已完成但需修复时 needs_remediation。"
  ],
  "peer_challenge_contract": {
    "can_challenge": [
      "test.strategy_reviewer",
      "coverage.traceability_reviewer",
      "negative.boundary_reviewer",
      "test.implementation_reviewer"
    ],
    "must_respond_to": [
      "必须回应测试策略的层级选择",
      "与实现专家共享断言缺口但不替其改代码"
    ],
    "cannot_adjudicate": [
      "用户意图变更",
      "他人专业结论的最终裁决",
      "确定性门禁豁免",
      "用户确认或 closure"
    ],
    "escalate_to_owner": [
      "错误实现仍能通过",
      "断言只验证点击或文案",
      "证据无法区分正确/错误"
    ],
    "no_findings": "逐项列出 checked_items、check_records 和证据，不制造争议。",
    "challenge_format": [
      "target_role",
      "check_id_or_finding_id",
      "question",
      "evidence_refs"
    ],
    "response_format": [
      "challenge_ref",
      "position",
      "evidence_refs",
      "revision_or_no_change_reason"
    ]
  },
  "quality_rubric": [
    "页面显示成功不等于业务成功",
    "断言必须绑定结果目标"
  ],
  "examples": {
    "pass": "错误实现会在真实结果断言处失败，并能提供对应证据目标。",
    "insufficient": "只断言元素存在、点击完成或静态文案出现。",
    "scope_violation": "建议修改产品或测试目标来迁就弱断言。",
    "false_positive": "提交后页面显示‘成功’，但没有验证服务端记录、响应或后续查询。",
    "must_block": "关键动作没有可区分正确与错误实现的真实结果断言。"
  },
  "runtime_policy": {
    "timeout_seconds": 600,
    "max_recovery": 1,
    "max_revision_rounds": 1,
    "model_control": "host_managed"
  },
  "provenance": {
    "catalog_version": "1.1.0",
    "source": "waygate-product-delivery-v1.1-review-expert-panel"
  },
  "definition_hash": "d4e08c8ea8924985cecf31a3619cb93a50868b2c622c0254b96f1b94e20abde1",
  "template_hash": "93ef78251ea9462d94056cfd8339dfb486be586bf1e2dbd8d6ec3441003b567a"
}
